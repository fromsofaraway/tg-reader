# Copy to .env and fill in. Never commit .env.
# API credentials for a user account: create an app at https://my.telegram.org
TG_API_ID=
TG_API_HASH=
# Phone of the support account in international format (optional; asked interactively if empty)
TG_PHONE=
# Where the Telethon session (auth key) is stored. Treat it like a password.
TG_SESSION=data/session/support
# Where raw and anonymized data go
TG_DATA_DIR=data
